{
  "name": "mbrd - infinite moodboard",
  "short_name": "mbrd",
  "description": "An infinite freeform board. Drop in images, video, audio, text or anything else and place it anywhere. Runs entirely in your browser; boards save as a single .mbrd file.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf8f3",
  "theme_color": "#faf8f3",
  "icons": [
    { "src": "assets/img/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "assets/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "assets/img/screenshot-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "A board of images, audio and notes on the infinite canvas" },
    { "src": "assets/img/screenshot-narrow.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "The same board as a scrollable feed on a phone" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/vnd.mbrd+zip": [".mbrd"] },
      "icons": [{ "src": "assets/img/icon.svg", "sizes": "any", "type": "image/svg+xml" }],
      "launch_type": "single-client"
    }
  ]
}
