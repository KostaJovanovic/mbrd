# Worker exemptions — removed rather than replaced, because _headers rules are
# cumulative and two CSP values are intersected, not overridden. Each worker
# needs 'wasm-unsafe-eval' and/or cross-origin fetch that the site policy
# forbids. If a host ignores the removal, the worker keeps the strict policy
# and the feature degrades gracefully (the module already handles that).

# ffmpeg core: importScripts from jsdelivr + wasm compile.
# No DOM, no state, cannot reach the page.
/assets/js/optimize/media-worker.js
  ! Content-Security-Policy

# pdf.js JPEG 2000 decoder (Emscripten OpenJPEG, wasm compile).
# One file only — pdf.min.mjs in the document keeps the document's policy.
# Pinned by import/pdf.ts and tests/vendor.test.js.
/assets/vendor/pdfjs/pdf.worker.min.mjs
  ! Content-Security-Policy

# Background remover (u2netp on ONNX Runtime wasm backend).
# WebGL backend does not work (no int64 for Resize nodes — see matte.ts).
# Same-origin only, no CDN needed. Pinned by ORT_VERSION in canvas/matte.ts.
/assets/js/canvas/matte-worker.js
  ! Content-Security-Policy

# Open CASCADE (STEP/IGES tessellation). Wasm compile.
# Fallback: mesh/step.ts and mesh/iges.ts still read both formats (lower
# fidelity). Same-origin, no network. Pinned by OCCT_VERSION in mesh/occt.ts.
# Licence requires serving, not bundling — see web/assets/vendor/occt/LICENSE.txt.
/assets/js/mesh/occt-worker.js
  ! Content-Security-Policy

# libarchive.js (7z, RAR, and a ZIP the hand reader refuses): a module worker
# that compiles libarchive.wasm. Same-origin, no network, loaded on the first
# archive that needs it. Pinned by LIBARCHIVE_VERSION in import/archive.ts.
/assets/vendor/libarchive/worker-bundle.js
  ! Content-Security-Policy

# LibRaw (camera RAW: the Demosaic row and Optimize): a module worker that
# compiles libraw.wasm. Same-origin, no network, loaded on the first RAW that
# is developed. Pinned by LIBRAW_VERSION in optimize/demosaic.ts.
/assets/vendor/libraw/worker.js
  ! Content-Security-Policy

# libheif, through heic2any (HEIC on an origin with no WebCodecs): a classic
# worker that importScripts the vendored build. No wasm here and no network -
# it is JavaScript - but libheif reaches Emscripten's embind, which builds its
# exports with `new Function`, and the page carries no 'unsafe-eval'. Loaded on
# the first HEIC that WebCodecs did not already draw. Pinned by
# HEIC2ANY_VERSION in import/heif.ts.
/assets/js/import/heif-worker.js
  ! Content-Security-Policy
