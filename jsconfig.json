{
  // Type checking without a build step, and without TypeScript in the app.
  //
  // Nothing here is compiled and nothing is emitted: `npm run typecheck` runs
  // tsc in --noEmit mode over plain JavaScript, reading types out of JSDoc
  // comments and inference. The browser still loads the same .js files it
  // always did. This is the answer to the one real argument for rewriting the
  // app on a framework - see the foot of docs/architecture.md.
  //
  // Scoped deliberately to the pure layer: the modules with no DOM, no state
  // import and a real contract worth stating - geometry, measurement, the
  // arrangement engine, the ZIP container and the .mbrd on top of it. Those are
  // where a wrong type is a silently wrong board rather than a visible mistake,
  // and where annotations cost least. Widening the `include` below is how this
  // grows; do it a module at a time, with the run clean at each step.
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "web/assets/js/geometry.js",
    "web/assets/js/measure.js",
    "web/assets/js/quality.js",
    "web/assets/js/layout-settings.js",
    "web/assets/js/web-graph.js",
    "web/assets/js/web-route.js",
    "web/assets/js/canvas/spatial.js",
    "web/assets/js/import/budget.js",
    "web/assets/js/arrange/arrangements.js"
  ]
}
