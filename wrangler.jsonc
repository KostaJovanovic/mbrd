// Cloudflare Workers deploy config. No Worker script — static files only.
// Explicit config because wrangler's autodetect invents a non-committed one.
// No $schema: wrangler is not a devDependency, the path would resolve nowhere.
{
  "name": "mbrd",
  "compatibility_date": "2026-08-12",
  "assets": {
    // web/ is the site; everything above it never ships.
    "directory": "./web",

    // Serves web/404.html (byte copy of index.html) with a real 404 status.
    // "none" would be a bare 404; "single-page-application" would be a soft 200.
    "not_found_handling": "404-page"
  }
}
