# Boards are user data, not source. Keep test boards out of the repo.
*.mbrd
!docs/examples/*.mbrd

# Python
__pycache__/
*.py[cod]

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Tauri (M4+)
src-tauri/target/
src-tauri/gen/

# Node. The app has no dependencies; these are the two optional dev tools -
# `npm run typecheck` and `npm run test:e2e`. `npm test` needs neither, and
# needs no install at all.
node_modules/

# Playwright output. The runs are optional and local; nothing here is source.
test-results/
playwright-report/
.playwright/

# Tool output: code-graph dumps, including session transcripts.
graphify-out/

# Local tunnel binary - a 52MB vendored exe, not source.
cloudflared.exe
