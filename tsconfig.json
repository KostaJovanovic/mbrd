{
  // Strict TypeScript, check only (noEmit). esbuild builds, tsc checks.
  //
  // erasableSyntaxOnly: Node 22.18 strips types natively. Enums, namespaces,
  // parameter properties would break `npm test` without a loader. This flag
  // makes tsc refuse them. verbatimModuleSyntax forces `import type`.
  //
  // allowImportingTsExtensions: real .ts extensions keep two promises —
  // `npm test` needs no install (Node resolves as written), esbuild needs no
  // plugin.
  //
  // allowJs + checkJs false: three .js files remain (two workers + version.js).
  // When the last .js is gone, both flags come out.
  //
  // types: [] is deliberate. Without it tsc walks @types/* upwards and a stray
  // @types/node makes 29 setTimeout handles go red. Tests are .js outside
  // `include` and need nothing here.
  "compilerOptions": {
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["web/assets/js/**/*.ts"]
}
