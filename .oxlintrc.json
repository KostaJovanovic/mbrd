// Correctness only, no formatter. oxlint + vendored anti-slop plugin.
//
// anti-slop fires on TypeScript patterns that hide mistakes (double casts,
// unknown returns, index signatures standing in for types), not on layout.
//
// Five rules are off because the flagged syntax IS the boundary in this repo:
//   no-runtime-typeof         feature detection + .mbrd parsing are correct typeof
//   no-unknown-parameters     coercers/type guards ARE the boundary
//   no-unsafe-dictionary-type Record<string, unknown> is pre-validation
//   no-shape-in-symbol-names  "shape" is a domain noun (stickers)
//   no-known-value-widening   dispatch tables need runtime-string indexing
//
// no-unknown-returns is on except for idb.ts, errors.ts, desktop/store.ts,
// desktop/format.mts, platform/electron.ts — those return genuinely unknown
// bytes from older builds or Proxy traps.
//
// desktop/ is linted (same rules) but not in the root tsconfig (needs Node types).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "node_modules",
    "graphify-out",
    "web/assets/js/import/formats.ts",
    "web/assets/vendor/**",
    "web/assets/app.js",
    "web/assets/app.js.map",
    "web/assets/lab-pigments.js",
    "web/assets/lab-sound.js",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "prefer-const": "error",
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-var": "error",
    "no-dupe-keys": "error",
    "no-unreachable": "error",
    "no-self-assign": "error",
    "no-constant-condition": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-shape-in-symbol-names": "off"
  },
  "overrides": [
    {
      "files": [
        "web/sw.js",
        "web/assets/js/optimize/media-worker.js",
        "web/assets/js/import/tiff-worker.js",
        "web/assets/js/mesh/occt-worker.js"
      ],
      "env": {
        "worker": true,
        "serviceworker": true
      }
    },
    {
      "files": [
        "tests/**",
        "tools/**",
        "desktop/**"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "web/assets/js/storage/idb.ts",
        "web/assets/js/errors.ts",
        "web/assets/js/platform/electron.ts",
        "desktop/store.ts",
        "desktop/format.mts"
      ],
      "rules": {
        "anti-slop/no-unknown-returns": "off"
      }
    }
  ]
}
