# Normalise line endings in text, and never let git touch a board.
* text=auto eol=lf

*.bat  text eol=crlf
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf

# .mbrd is a renamed ZIP - binary, and a diff of it is meaningless.
*.mbrd binary
*.png  binary
*.jpg  binary
*.webp binary
*.mp4  binary
*.mp3  binary
