<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- requestLegacyExternalStorage: Android 10 reads Documents/mbrd/ by path
         with the write permission only when this is set. Later versions ignore
         it and use MANAGE_EXTERNAL_STORAGE (MainActivity asks, MbrdRoot checks). -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" (plan §5.6). Listed in the chooser, never made the
                 default unless the user asks. content:// only: MbrdShell.deliver()
                 refuses file://. A .mbrd often arrives as octet-stream, so its
                 name or the ZIP magic decides there. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.mbrd+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- "Share to mbrd": a board opens, everything else lands as cards,
                 and a shared link (text/plain) becomes a link card. A SEND has
                 no data URI, so this filter names no scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.mbrd+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- MbrdUpdate's install session reports here. Not exported: only the
             PendingIntent the session was committed with can reach it. -->
        <receiver
            android:name=".MbrdUpdate$InstallStatus"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- MbrdUpdate asks whether the network is metered, for Data Saver. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Boards and the store in Documents/mbrd/ (plan §5.4). Android 7 to 10: -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Android 11 and later. A Play build must drop it (plan §1 #27). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- MbrdUpdate.java writes a downloaded update into an install session. A
         Google Play build must remove this line: Play forbids an app that
         updates itself (plan §1 #27). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
